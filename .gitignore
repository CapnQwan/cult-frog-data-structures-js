# =========================
# Dependencies
# =========================
node_modules/
.pnpm-store/

# =========================
# Build outputs
# =========================
dist/
build/
out/
coverage/
packages/engine/docs/
*.tsbuildinfo

# =========================
# Logs
# =========================
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# Environment files
# =========================
.env
.env.local
.env.*.local

# =========================
# OS junk
# =========================
.DS_Store
Thumbs.db

# =========================
# Editors / IDEs
# =========================
.vscode/*
# Shared editor config is committed so everyone gets Biome as the formatter.
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# =========================
# Vite / modern bundlers
# =========================
.vite/
.cache/
.parcel-cache/
.turbo/
.swc/

# =========================
# Monorepo (pnpm)
# =========================
.pnpm-debug.log*

# =========================
# Testing
# =========================
jest-cache/
vitest-cache/

# =========================
# Coverage
# =========================
coverage/

# =========================
# Misc tooling
# =========================
.eslintcache
.prettiercache

# =========================
# Pre commit hooks
# =========================
.pre-commit-config.yaml

# =========================
# Optional: local tooling state
# =========================
.tmp/
temp/

# Never commit compiled output that lands next to sources
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
src/**/*.d.ts.map